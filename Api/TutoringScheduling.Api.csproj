<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Composition root: HTTP endpoints, static files and startup wiring. References
    Application (use cases) and Infrastructure (their EF Core implementation).
  -->
  <PropertyGroup>
    <RootNamespace>TutoringScheduling.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\seed-data\**" CopyToOutputDirectory="PreserveNewest" LinkBase="seed-data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\TutoringScheduling.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\TutoringScheduling.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Design-time EF Core services for `dotnet ef`, with this as the startup project. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
