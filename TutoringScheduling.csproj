<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <Content Include="seed-data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The test project lives under Tests/; keep its sources out of this build. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>

  <!-- Each layer is its own project now; don't also compile them here. -->
  <ItemGroup>
    <Compile Remove="Domain/**" />
    <Compile Remove="Application/**" />
    <Compile Remove="Infrastructure/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Application/TutoringScheduling.Application.csproj" />
    <ProjectReference Include="Infrastructure/TutoringScheduling.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TutoringScheduling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
