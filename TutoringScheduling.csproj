<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <Content Include="seed-data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The test project lives under Tests/; keep its sources out of this build. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
  </ItemGroup>

  <!-- Domain and Application are their own projects now; don't also compile them here. -->
  <ItemGroup>
    <Compile Remove="Domain/**" />
    <Compile Remove="Application/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Domain/TutoringScheduling.Domain.csproj" />
    <ProjectReference Include="Application/TutoringScheduling.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TutoringScheduling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
